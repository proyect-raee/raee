{
  "name": "pmi-realty-client",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.x",
    "npm": "10.x"
  },
  "engineStrict": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --ci --verbose --bail --run-in-band --passWithNoTests",
    "test:watch": "jest --watch"
  },
  "lint-staged": {
    "*.{ts,js,tsx}": [
      "eslint --fix",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "*.{js,ts,md,json,html}": "prettier --write"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.26.3",
    "@tanstack/react-query-next-experimental": "^5.26.3",
    "axios": "^1.6.7",
    "next": "14.1.0",
    "react": "^18",
    "react-aria-components": "^1.1.1",
    "react-dom": "^18",
    "react-icons": "^5.0.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.26.3",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "14.2.1",
    "@types/jest": "29.5.12",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "clsx": "^2.1.0",
    "eslint": "^8",
    "eslint-config-next": "14.1.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-jest": "27.9.0",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "9.0.11",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "lint-staged": "15.2.2",
    "postcss": "^8",
    "prettier": "3.2.5",
    "tailwindcss": "^3.3.0",
    "tailwindcss-react-aria-components": "^1.1.1",
    "ts-node": "10.9.2",
    "typescript": "^5"
  },
  "resolutions": {
    "wrap-ansi": "7.0.0",
    "string-width": "4.1.0"
  }
}
